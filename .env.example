# ParkOrbit — Peer-to-Peer Parking Rental Platform Environment Variables
# Copy this file to .env.local for local overrides. All features work out-of-the-box with safe defaults.

# Database Persistence Path (defaults to ./data/parkorbit-db.json)
PARKORBIT_DB_PATH="./data/parkorbit-db.json"

# Marketplace Business Model Configuration
PLATFORM_COMMISSION_PERCENT="12"
DRIVER_SERVICE_FEE_PERCENT="5"

# Payment & Payout Mode
# Set to "simulated_test" when live Razorpay/Stripe UPI keys are not configured.
# Never claims real money has been collected or paid out when in simulated_test mode.
PAYMENT_PROVIDER_MODE="simulated_test"
PAYOUT_PROVIDER_MODE="estimated_pending"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Map & Location Discovery Configuration
# Works out of the box with interactive coordinate canvas + OpenStreetMap / Haversine geo engine.
# Optional Google Maps / Mapbox key if external vector tiles are desired:
NEXT_PUBLIC_MAP_PROVIDER="interactive_orbit"
NEXT_PUBLIC_MAPS_API_KEY=""

# Authentication Session Secret
SESSION_SECRET="parkorbit-dev-secret-change-in-production"
